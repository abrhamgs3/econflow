# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# ============================================================
# Virtual environments & package managers
# ============================================================
.venv/
venv/
env/
ENV/
.uv/

# uv.lock is committed in application repos but not in libraries.
# EconFlow is a library — lock file is intentionally excluded.
# uv.lock

# ============================================================
# Testing & linting
# ============================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/

# ============================================================
# Type checking
# ============================================================
.mypy_cache/
.pytype/

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ============================================================
# EconFlow generated outputs
# Generated on every run; not version-controlled.
# ============================================================
outputs/*/tables/
outputs/*/figures/
outputs/*/run_metadata.json

# Keep directory stubs and reproducibility record
!outputs/.gitkeep
!outputs/provenance/schema.json
!outputs/provenance/REPRODUCIBILITY_REPORT.md

# ============================================================
# Raw and processed data
# Source data should not be version-controlled.
# ============================================================
.cache/
data/raw/
data/processed/
data/interim/
data/external/

!data/.gitkeep

# ============================================================
# OS & editor
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ============================================================
# Secrets
# ============================================================
.env
.env.*
*.env
secrets.yaml
secrets.yml
.streamlit/secrets.toml

# Getting started tutorial generated outputs
examples/*/outputs/tables/
examples/*/outputs/figures/
examples/*/outputs/provenance/

# ============================================================
# User-generated study directories (created by econflow init)
# These are workspace projects, not platform code.
# ============================================================
my_test_study/
*_study/
*_project/
